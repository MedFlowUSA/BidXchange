SUPABASE_URL=
SAM_GOV_API_KEY=
BIDXCHANGE_SOURCES_ENABLED=false
BIDXCHANGE_SAM_SYNC_ENABLED=false
BIDXCHANGE_SAM_SYNC_LOOKBACK_DAYS=7
BIDXCHANGE_SAM_SYNC_PAGE_LIMIT=100
BIDXCHANGE_SAM_SYNC_MAX_PAGES=5
BIDXCHANGE_SAM_SYNC_TIMEOUT_MS=10000
# Operator job only. Explicit target; never falls back to linked production.
BIDXCHANGE_SOURCE_DATABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=
# Optional protected setup commands only; never NEXT_PUBLIC or browser values.
GES_ADMIN_USER_ID=
GES_ADMIN_EMAIL=
# Optional database test connection; otherwise uses the authenticated Supabase CLI.
BIDXCHANGE_TEST_DATABASE_URL=
NODE_EXTRA_CA_CERTS=
# Server only. Configure a model available to your OpenAI project explicitly.
OPENAI_API_KEY=
BIDXCHANGE_AI_PUBLIC_DEMO_ENABLED=false
# Server-only Supabase service key used only by the public-demo quota endpoint.
BIDXCHANGE_DEMO_AI_SERVICE_KEY=
OPENAI_MODEL=
# Global kill switch; also requires an operator-enabled organization setting.
BIDXCHANGE_AI_ENABLED=false
# Enable only after approved evidence review migrations 007, 008 and 009 are installed.
BIDXCHANGE_EVIDENCE_REVIEWS_ENABLED=false
# Requires separately approved migration 010.
BIDXCHANGE_DECISIONS_ENABLED=false
# Requires separately approved requirement-resolution migration 011.
BIDXCHANGE_RESOLUTIONS_ENABLED=false
BIDXCHANGE_DOCUMENTS_ENABLED=false
# Requires reviewed migration 015. App disable does not revoke database RPC access.
BIDXCHANGE_RELEASES_ENABLED=false
# Enable only after structured-company migration 016 is installed.
BIDXCHANGE_STRUCTURED_PROFILES_ENABLED=false
# California workflow: apply and validate migrations 020–025 before enabling.
# Register sign-off also requires decisions and requirement resolutions enabled.
BIDXCHANGE_REGISTER_SIGNOFF_ENABLED=false
BIDXCHANGE_CONTRACTOR_WORKFLOW_ENABLED=false
# Scripted fictional demo only; never enables anonymous paid requests.
BIDXCHANGE_AI_DEMO_ENABLED=false
# Positive integer daily request reservations, UTC day; database ceilings also apply.
BIDXCHANGE_AI_DAILY_ORG_LIMIT=100
BIDXCHANGE_AI_DAILY_USER_LIMIT=20

# Enable only after migration 027 and verified-email signup/invitation tests pass.
BIDXCHANGE_SELF_SERVICE_ENABLED=false
